{
  "name": "g-style",
  "version": "2.0.0",
  "description": "Lightweight CSS-in-JS library",
  "license": "MIT",
  "author": "Lucas Rainett",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "format": "prettier --write src",
    "build": "tsup"
  },
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com/lucasrainett/g-style.git"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^3.0.0",
    "jsdom": "^25.0.0",
    "prettier": "^3.4.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "prettier": {
    "useTabs": true,
    "printWidth": 200
  }
}
